{
  "family": "fcg-catalog-service-task",
  "networkMode": "bridge",
  "containerDefinitions": [
    {
      "name": "fcg-catalog-service-container",
      "image": "catalog-service:latest",
      "cpu": 256,
      "memory": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5002,
          "hostPort": 5002,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "EC2"
  ]
}