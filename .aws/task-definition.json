{
  "family": "fcg-catalog-service-task",
  "networkMode": "bridge",
  "containerDefinitions": [
    {
      "name": "fcg-catalog-service-container",
      "image": "catalog-service:latest",
      "cpu": 256,
      "memory": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5002,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:5002/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ],
  "requiresCompatibilities": [
    "EC2"
  ]
}