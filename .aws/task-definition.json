{
  "family": "fcg-catalog-service-task",
  "networkMode": "bridge",
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "640",
  "memory": "640",
  "taskRoleArn": "arn:aws:iam::915153720516:role/fcg-catalog-service-ecs-task-role",
  "volumes": [
    {
      "name": "catalog-data"
    }
  ],
  "containerDefinitions": [
    {
      "name": "fcg-catalog-service-container",
      "image": "915153720516.dkr.ecr.sa-east-1.amazonaws.com/fcg-catalog-service:latest",
      "cpu": 256,
      "memory": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5002,
          "hostPort": 5002,
          "protocol": "tcp"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "catalog-data",
          "containerPath": "/data"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:5002/health || exit 1"],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      },
      "environment": [
        {
          "name": "ConnectionStrings__DefaultConnection",
          "value": "Data Source=/data/catalog.db"
        },
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "value": "Production"
        },
        {
          "name": "ASPNETCORE_URLS",
          "value": "http://+:5002"
        },
        {
          "name": "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT",
          "value": "1"
        },
        {
          "name": "Messaging__Provider",
          "value": "Sqs"
        },
        {
          "name": "AWS__Region",
          "value": "sa-east-1"
        },
        {
          "name": "ConnectionStrings__Redis",
          "value": "localhost:6379"
        },
        {
          "name": "DynamoDb__ServiceUrl",
          "value": ""
        },
        {
          "name": "DynamoDb__Region",
          "value": "sa-east-1"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fcg-catalog-service",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "fcg-catalog-redis",
      "image": "public.ecr.aws/docker/library/redis:alpine",
      "cpu": 64,
      "memory": 128,
      "essential": false,
      "portMappings": [
        {
          "containerPort": 6379,
          "hostPort": 6379,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fcg-catalog-service",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "redis"
        }
      }
    },
    {
      "name": "fcg-catalog-service-worker",
      "image": "915153720516.dkr.ecr.sa-east-1.amazonaws.com/fcg-catalog-service:worker-latest",
      "cpu": 128,
      "memory": 128,
      "essential": false,
      "dependsOn": [
        {
          "containerName": "fcg-catalog-service-container",
          "condition": "HEALTHY"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "catalog-data",
          "containerPath": "/data"
        }
      ],
      "environment": [
        {
          "name": "ConnectionStrings__DefaultConnection",
          "value": "Data Source=/data/catalog.db"
        },
        {
          "name": "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT",
          "value": "1"
        },
        {
          "name": "Messaging__Provider",
          "value": "Sqs"
        },
        {
          "name": "AWS__Region",
          "value": "sa-east-1"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fcg-catalog-service",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}